[Unit]
Description=Pi metrics shim (power, throttle) for the fleet dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pi-metrics.py
Restart=always
RestartSec=5

# vcgencmd needs /dev/vcio, which is group video. No root required.
User=nobody
SupplementaryGroups=video

# The directories the file scanner is allowed to describe. Anything outside
# these is refused, so widening this line is the only way to widen its reach.
Environment=BROWSE_ROOTS=/srv/browse:/srv/archive

# It reads two sysfs files, shells out to vcgencmd, and walks the browse roots
# to size them. ProtectSystem=strict keeps every one of those read-only, so a
# bug in the scanner cannot write anything anywhere.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
# The scan holds a bounded cache of directory listings. 64M was enough when
# this only reported power and temperature; it is not enough now.
MemoryMax=128M

[Install]
WantedBy=multi-user.target
