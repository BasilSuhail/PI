[Unit]
Description=Pi metrics shim (power, throttle) for the fleet dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pi-metrics.py
Restart=always
RestartSec=5

# install.sh drops in the login user. Not root, and not nobody either: nobody
# cannot enter a home directory, so the browser showed empty folders where the
# actual work is. As the login user it sees what an ssh session would see, and
# no more — Docker's internal storage stays root-owned and invisible.
#
# vcgencmd needs /dev/vcio, which is group video.
User=nobody
SupplementaryGroups=video

# Named tops of the tree, as label=path. Everything under them is readable —
# a browser that cannot show your own code or a config under /etc is a folder,
# not a file manager. install.sh adds a home= shortcut for the login user.
Environment=BROWSE_ROOTS=system=/,archives=/srv/archive

# The only paths that may ever be modified, once write endpoints exist.
# Everything else is permanently read-only, whatever the interface offers.
Environment=BROWSE_WRITABLE=/srv/archive:/srv/browse

# Thumbnails. systemd creates /var/cache/jug-thumbs owned by this service and
# makes it writable despite ProtectSystem=strict — the one path this process
# may write, and everything in it is derived and safe to delete.
CacheDirectory=jug-thumbs
Environment=THUMB_DIR=/var/cache/jug-thumbs
Environment=THUMB_CACHE_MAX_MB=500

# It reads two sysfs files, shells out to vcgencmd, and walks the browse roots
# to size them. ProtectSystem=strict keeps every one of those read-only, so a
# bug in the scanner cannot write anything anywhere.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
# The scan holds a bounded cache of directory listings, and thumbnailing is a
# child process rather than a library, so this stays low deliberately. 128M is
# a kill switch, not an allowance: reaching it means something is wrong.
MemoryMax=128M

[Install]
WantedBy=multi-user.target
